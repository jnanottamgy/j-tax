# ─────────────────────────────────────────────────────────────────────────────
# J-TACS environment
#
# Copy to .env.local for development, or set these in your hosting provider for
# production. `npm run env:check` verifies the required ones are present and
# well-formed before you go live.
#
# NEVER commit a real .env file. Every value below is a secret except the two
# marked NEXT_PUBLIC_, which are shipped to the browser by design.
# ─────────────────────────────────────────────────────────────────────────────

# ── Required: database ───────────────────────────────────────────────────────
# Postgres connection string. Use the pooled (pgbouncer) URL for the app.
DATABASE_URL="postgresql://user:password@host:5432/database"

# ── Required: authentication (Supabase) ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Server-side only. Creates staff and client-portal logins. Never expose this.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# ── Required: the app's own address ──────────────────────────────────────────
# Used in invite emails and password links. Wrong value = links that go nowhere.
NEXT_PUBLIC_APP_URL="https://yourfirm.example.com"

# ── Required: credential vault ───────────────────────────────────────────────
# AES-256 key for the government-portal credential vault. Exactly 64 hex chars.
# Generate with:  openssl rand -hex 32
# Losing this makes every stored credential permanently unreadable. Back it up
# somewhere other than the server it runs on.
CREDENTIAL_VAULT_KEY=""

# ── Required: scheduled jobs ─────────────────────────────────────────────────
# Shared secret the cron routes check. Any long random string.
# Generate with:  openssl rand -hex 32
# Without it every cron route returns 503 and nothing runs on a schedule:
# no reminders, no retainer invoices, no attendance close-off.
CRON_SECRET=""

# ── Required for email: Resend ───────────────────────────────────────────────
# Without this, invites, reminders and client emails silently do not send.
RESEND_API_KEY=""
# The address clients see. Must be on a domain verified in Resend.
FROM_EMAIL="noreply@yourfirm.example.com"
# Used for platform-level mail (staff invites) when a firm has no sender set.
PLATFORM_FROM_EMAIL="noreply@yourfirm.example.com"

# ── Optional: WhatsApp (Meta Cloud API) ──────────────────────────────────────
# Reminders fall back to email alone when these are unset.
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
WHATSAPP_API_VERSION="v21.0"
# Approved template names, per reminder type. Unset = that reminder is email-only.
WHATSAPP_TEMPLATE_COMPLIANCE_REMINDER=""

# ── Optional: fallback firm identity ─────────────────────────────────────────
# Only used before a firm completes setup. Firm Settings overrides all of these.
FIRM_NAME=""
FIRM_PHONE=""
FIRM_ADDRESS=""

# ── Optional: performance ────────────────────────────────────────────────────
ENABLE_READ_REPLICAS="false"
READ_REPLICA_URLS=""
CDN_ENABLED="false"
CDN_PROVIDER=""
CDN_DOMAIN=""
