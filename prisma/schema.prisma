generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Firm Settings ────────────────────────────────────────────────────────────

/// A tenant — one CA firm's isolated workspace. Every business row carries
/// firmId; lib/prisma.ts enforces isolation automatically from the session.
model Firm {
  id          String    @id @default(cuid())
  name        String
  /// TRIAL | STARTER | GROWTH | PROFESSIONAL — billing enforcement comes later
  plan        String    @default("TRIAL")
  /// ACTIVE | SUSPENDED
  status      String    @default("ACTIVE")
  trialEndsAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  settings    FirmSettings?
  users User[]
  employees Employee[]
  clients Client[]
  clientGroups ClientGroup[]
  tasks Task[]
  taskAutomations TaskAutomation[]
  complianceSchedules ComplianceSchedule[]
  complianceEvents ComplianceEvent[]
  documents Document[]
  documentRequests DocumentRequest[]
  messages Message[]
  messageTemplates MessageTemplate[]
  invoices Invoice[]
  reminders Reminder[]
  activityLogs ActivityLog[]
  auditLogs AuditLog[]
  employeeSessions EmployeeSession[]
  employeeActivitys EmployeeActivity[]
  attendanceRecords AttendanceRecord[]
  leads Lead[]
  quotations Quotation[]
  quotationFollowUps QuotationFollowUp[]
  clientTimelineEvents ClientTimelineEvent[]
  statutoryRegistrations StatutoryRegistration[]
  dscRecords DscRecord[]
  udinRecords UdinRecord[]
  jobTemplates JobTemplate[]
  timeEntrys TimeEntry[]
  gstReconRuns GstReconRun[]
  itrComputations ItrComputation[]
  taxNotices TaxNotice[]
  financialStatements FinancialStatement[]

  @@map("firms")
}

model FirmSettings {
  firmId String  @unique
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id           String   @id @default(cuid())
  firmName     String   @default("Your Tax Firm")
  fromEmail    String   @default("")
  replyToEmail String?
  firmPhone    String?
  firmAddress  String?
  gstin        String?
  pan          String?
  website      String?
  // ── Domain verification (Phase 8) ─────────────────────────────────────────
  firmDomain        String?    // e.g. "taxwiseconsultants.com" — extracted from fromEmail
  domainVerified    Boolean    @default(false)
  domainVerifiedAt  DateTime?
  // Suggested DNS records are deterministic and computed in code, but we
  // persist a verification token so the same TXT value can be re-shown later.
  verificationToken String?
  // When true, unverified domains fall back to platform-domain sending with
  // firm display name + firm reply-to (default true; PARTNER can opt out)
  platformFallbackEnabled Boolean @default(true)

  // ── Payment collection details (shown to clients in the portal Pay dialog) ─
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankName          String?
  upiId             String?

  updatedAt    DateTime @updatedAt
  updatedBy    String?

  @@map("firm_settings")
}

// ─── Staff & auth sync ───────────────────────────────────────────────────────

enum Role {
  PARTNER
  MANAGER
  EMPLOYEE
  CLIENT
}

model User {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id              String   @id @default(cuid())
  name            String
  email           String   @unique
  role            Role
  onboardingCompleted Boolean @default(false)
  onboardingStep  Int      @default(0)
  createdAt       DateTime @default(now())

  employee        Employee?
  notifications   Notification[]
  @@index([firmId])
}

model Employee {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id         String   @id @default(cuid())
  userId     String?  @unique
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  email      String  
  department String?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  clients            Client[]
  tasks              Task[]
  sessions           EmployeeSession[]
  activities         EmployeeActivity[]
  attendanceRecords  AttendanceRecord[]
  teamMemberships    ClientTeamMember[]
  timeEntries        TimeEntry[]
  reviewTasks        Task[]             @relation("TaskReviewer")
  taxNotices         TaxNotice[]

  @@index([name])
  @@index([department])
  @@map("employees")
  @@index([firmId])
  @@unique([firmId, email])
}

// ─── Client master entity ────────────────────────────────────────────────────

enum ClientStatus {
  ACTIVE
  INACTIVE
  PENDING
  ON_HOLD
}

enum ClientPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ServiceType {
  GST_RETURN
  INCOME_TAX
  TDS
  PAYROLL
  BOOKKEEPING
  AUDIT
  COMPANY_LAW
  INCORPORATION
  OTHER
}

enum ServiceFrequency {
  MONTHLY
  QUARTERLY
  ANNUAL
  ONE_TIME
}

model Client {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id                   String         @id @default(cuid())
  clientCode           String        
  name                 String
  gstin                String?
  pan                  String?
  email                String?
  phone                String?
  whatsapp             String?
  address              String?
  notes                String?
  status               ClientStatus   @default(PENDING)
  priority             ClientPriority @default(MEDIUM)
  assignedEmployeeId   String?
  assignedEmployeeName String?
  assignedEmployee     Employee?      @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  phoneNumber          String?
  /// Legal/registered company name (may differ from display `name`)
  companyName          String?
  /// Whether the entity is already incorporated/registered. Defaults true;
  /// unchecked for entities being freshly incorporated via our Incorporation service.
  isIncorporated       Boolean        @default(true)
  /// Constitution: PROPRIETORSHIP, PARTNERSHIP, LLP, PVT_LTD, PUBLIC_LTD, SECTION_8, HUF, TRUST, AOP, INDIVIDUAL, OTHER
  entityType           String?
  /// Free-text label when entityType is OTHER
  entityTypeCustom     String?
  /// GST place-of-supply state (falls back to the state encoded in gstin)
  stateCode            String?
  groupId              String?
  group                ClientGroup?   @relation(fields: [groupId], references: [id], onDelete: SetNull)
  /// Soft delete — recycle bin. Every list/query must filter deletedAt: null.
  deletedAt            DateTime?

  services             ClientService[]
  documentChecklist    ClientDocumentChecklistItem[]
  tasks                Task[]
  complianceSchedules  ComplianceSchedule[]
  documents            Document[]
  invoices             Invoice[]
  reminders            Reminder[]
  messages             Message[]
  complianceEvents     ComplianceEvent[]
  timelineEvents       ClientTimelineEvent[]
  contacts             ClientContact[]
  teamMembers          ClientTeamMember[]
  credentials          ClientCredential[]
  registrations        StatutoryRegistration[]
  dscRecords           DscRecord[]
  udinRecords          UdinRecord[]
  timeEntries          TimeEntry[]
  documentRequests     DocumentRequest[]
  gstReconRuns         GstReconRun[]
  itrComputations      ItrComputation[]
  taxNotices           TaxNotice[]
  financialStatements  FinancialStatement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([priority])
  @@index([name])
  @@index([assignedEmployeeId])
  @@index([status, priority])
  @@index([assignedEmployeeId, status])
  @@index([groupId])
  @@index([deletedAt])
  @@map("clients")
  @@index([firmId])
  @@unique([firmId, clientCode])
  @@unique([firmId, gstin])
  @@unique([firmId, pan])
}

model ClientService {
  id          String           @id @default(cuid())
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  serviceType ServiceType
  /// Free-text name when serviceType is OTHER (e.g. "Trademark filing").
  /// Null for the standard service types.
  customName  String?
  frequency   ServiceFrequency
  isActive    Boolean          @default(true)
  nextDueDate DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([clientId, serviceType])
  @@map("client_services")
}

/// A document the client needs to provide (generated from their service mix at
/// onboarding, editable afterwards). `collected` tracks whether the firm has
/// received it.
model ClientDocumentChecklistItem {
  id          String    @id @default(cuid())
  clientId    String
  client      Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  label       String
  collected   Boolean   @default(false)
  collectedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([clientId])
  @@map("client_document_checklist_items")
}

// ─── Connected modules (placeholders ready) ────────────────────────────────

enum TaskStatus {
  NOT_STARTED
  IN_PROGRESS
  DATA_AWAITED
  UNDER_REVIEW
  FILED_DONE
  ON_HOLD
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

/// Whether the assigned employee has accepted the task. Kept separate from
/// TaskStatus so it doesn't entangle the review/dependency gates.
enum TaskAcceptance {
  PENDING
  ACCEPTED
  DECLINED
}

model Task {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id                String           @id @default(cuid())
  clientId          String
  client            Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title             String
  description       String?
  status            TaskStatus       @default(NOT_STARTED)
  priority          TaskPriority     @default(MEDIUM)
  dueDate           DateTime?
  completionDate    DateTime?
  serviceType       ServiceType?
  assignedEmployeeId String?
  assignedEmployee  Employee?        @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  /// Assignment acceptance by the employee (accept/decline workflow).
  acceptanceStatus  TaskAcceptance   @default(PENDING)
  acceptedAt        DateTime?
  declinedAt        DateTime?
  declinedReason    String?
  remarks           String?
  isOverdue         Boolean          @default(false)
  escalated         Boolean          @default(false)
  escalationLevel   Int              @default(0)
  /// Reviewer sign-off (preparer → reviewer gate)
  reviewerEmployeeId String?
  reviewer          Employee?        @relation("TaskReviewer", fields: [reviewerEmployeeId], references: [id], onDelete: SetNull)
  /// Time budget in minutes (budget-vs-actual against timeEntries)
  estimatedMinutes  Int?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  comments          TaskComment[]
  attachments       TaskAttachment[]
  automations       TaskAutomation[]
  complianceEvents  ComplianceEvent[]
  checklistItems    TaskChecklistItem[]
  timeEntries       TimeEntry[]
  /// Dependencies where THIS task is blocked (must wait for blockers)
  blockedBy         TaskDependency[]  @relation("TaskBlockedBy")
  /// Dependencies where THIS task is the blocker (others wait on it)
  blocking          TaskDependency[]  @relation("TaskBlocks")

  @@index([clientId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([assignedEmployeeId])
  @@index([status, priority])
  @@index([assignedEmployeeId, status])
  @@index([clientId, status])
  @@index([dueDate, status])
  @@index([title])
  @@index([assignedEmployeeId, acceptanceStatus])
  @@map("tasks")
  @@index([firmId])
}

/// Schedule III financial statements generated from an imported trial
/// balance. Ledger mappings are stored so a sheet can be reopened and
/// re-mapped; statements are rebuilt server-side from ledgers on save.
model FinancialStatement {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// e.g. "2025-26"
  financialYear String
  /// MappedLedger[] (name, group, debit, credit, bucket, matched)
  ledgers       Json
  /// Statements JSON (pl, bs, checks) — rebuilt from ledgers on every save
  statements    Json
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, financialYear])
  @@map("financial_statements")
  @@index([firmId])
}

/// Tax notice / litigation register — one row per notice received.
/// Status values: OPEN, REPLY_DRAFTED, REPLIED, HEARING, CLOSED_FAVOURABLE,
/// CLOSED_UNFAVOURABLE, CLOSED_PARTIAL.
model TaxNotice {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id                 String    @id @default(cuid())
  clientId           String
  client             Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// e.g. "GST DRC-01", "IT 143(2)", "IT 148", "TDS 200A"
  noticeType         String
  /// Statute section quoted on the notice
  section            String?
  /// Issuing authority, e.g. "ITO Ward 4(2), Pune", "State GST, Mumbai"
  authority          String?
  /// Reference / DIN number on the notice
  referenceNo        String?
  noticeDate         DateTime?
  receivedDate       DateTime?
  replyDueDate       DateTime?
  hearingDate        DateTime?
  status             String    @default("OPEN")
  /// Demand raised (₹), if any
  demandAmount       Decimal?  @db.Decimal(14, 2)
  description        String?
  /// Running notes: reply filed, submissions, outcomes
  notes              String?
  assignedEmployeeId String?
  assignedEmployee   Employee? @relation(fields: [assignedEmployeeId], references: [id], onDelete: SetNull)
  createdBy          String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([clientId])
  @@index([status])
  @@index([replyDueDate])
  @@index([hearingDate])
  @@map("tax_notices")
  @@index([firmId])
}

/// A saved ITR computation (both regimes) for one client + financial year.
/// Inputs are stored so the sheet can be reopened/edited; results are always
/// recomputed server-side from inputs on save.
model ItrComputation {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// e.g. "2025-26"
  financialYear String
  /// OLD | NEW — the regime the firm decided to file under (null = undecided)
  regimeChosen  String?
  inputs        Json
  results       Json
  createdBy     String
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([clientId, financialYear])
  @@map("itr_computations")
  @@index([firmId])
}

/// A saved GSTR-2B ↔ purchase-register reconciliation run for one client+period.
model GstReconRun {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Return period as MMYYYY (portal convention), e.g. "062026"
  period    String
  /// GSTIN found inside the uploaded 2B file (cross-checked vs client.gstin)
  portalGstin String?
  /// ReconSummary JSON (counts, unclaimedItc, itcAtRisk, vendor rollup)
  summary   Json
  /// Parser diagnostics shown with the results
  diagnostics Json?
  createdBy String
  createdAt DateTime @default(now())

  entries   GstReconEntry[]

  @@index([clientId, period])
  @@index([createdAt])
  @@map("gst_recon_runs")
  @@index([firmId])
}

model GstReconEntry {
  id            String      @id @default(cuid())
  runId         String
  run           GstReconRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  /// MATCHED | MISMATCH | MISSING_IN_BOOKS | MISSING_IN_2B
  bucket        String
  supplierGstin String
  supplierName  String?
  /// ReconEntry JSON (books/portal sides, deltas, matchTier)
  data          Json

  @@index([runId, bucket])
  @@index([supplierGstin])
  @@map("gst_recon_entries")
}

/// Task sequencing: `task` cannot progress until `blocker` reaches FILED_DONE.
/// Cycle-checked at write time (app/actions/task-dependencies.ts).
model TaskDependency {
  id        String   @id @default(cuid())
  /// The dependent (blocked) task
  taskId    String
  task      Task     @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  /// The task that must complete first
  blockerId String
  blocker   Task     @relation("TaskBlocks", fields: [blockerId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([taskId, blockerId])
  @@index([blockerId])
  @@map("task_dependencies")
}

enum ComplianceStatus {
  SCHEDULED
  DUE
  COMPLETED
  OVERDUE
}

model ComplianceSchedule {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id           String           @id @default(cuid())
  clientId     String
  client       Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title        String
  jurisdiction String?
  dueDate      DateTime
  status       ComplianceStatus @default(SCHEDULED)
  serviceType  ServiceType?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([clientId])
  @@index([dueDate])
  @@index([status])
  @@index([clientId, dueDate])
  @@index([dueDate, status])
  @@map("compliance_schedules")
  @@index([firmId])
}

// ─── Document Vault Models ─────────────────────────────────────────────────

enum DocumentCategory {
  GST
  TDS
  ROC
  AUDIT
  INCOME_TAX
  PAYROLL
  BANK_STATEMENTS
  INVOICES
  AGREEMENTS
  OTHER
}

model Document {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id          String            @id @default(cuid())
  clientId    String
  client      Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title       String
  category    DocumentCategory  @default(OTHER)
  fileName    String
  fileSize    Int
  fileType    String
  storagePath String            // Supabase Storage path
  url         String?           // Temporary signed URL
  uploadedBy  String
  description String?
  isConfidential Boolean         @default(false)
  version     Int               @default(1)
  expiryDate  DateTime?
  renewalDate DateTime?
  /// Soft delete — recycle bin. Every list/query must filter deletedAt: null.
  deletedAt   DateTime?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  versions    DocumentVersion[]
  tags        DocumentTag[]
  activities  DocumentActivity[]
  requestItems DocumentRequestItem[]

  @@index([clientId])
  @@index([category])
  @@index([uploadedBy])
  @@index([createdAt])
  @@index([clientId, category])
  @@index([uploadedBy, createdAt])
  @@index([title])
  @@index([expiryDate])
  @@index([deletedAt])
  @@map("documents")
  @@index([firmId])
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  version     Int
  fileName    String
  fileSize    Int
  storagePath String
  uploadedBy  String
  changeNotes String?
  createdAt   DateTime @default(now())

  @@index([documentId])
  @@index([version])
  @@map("document_versions")
}

model DocumentTag {
  id          String   @id @default(cuid())
  documentId  String
  document    Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  tag         String
  createdAt   DateTime @default(now())

  @@unique([documentId, tag])
  @@index([documentId])
  @@index([tag])
  @@map("document_tags")
}

enum DocumentActivityType {
  UPLOADED
  DOWNLOADED
  VIEWED
  RENAMED
  DELETED
  VERSION_CREATED
  TAG_ADDED
  TAG_REMOVED
}

model DocumentActivity {
  id          String              @id @default(cuid())
  documentId  String
  document    Document            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  userId      String
  activityType DocumentActivityType
  metadata    Json?
  createdAt   DateTime            @default(now())

  @@index([documentId])
  @@index([userId])
  @@index([activityType])
  @@map("document_activities")
}

// ─── WhatsApp Automation Models ────────────────────────────────────────────

enum MessageStatus {
  PENDING
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RETRYING
}

enum TemplateType {
  DOCUMENT_REMINDER
  COMPLIANCE_REMINDER
  PAYMENT_REMINDER
  TASK_ASSIGNMENT
  OVERDUE_NOTIFICATION
  CUSTOM
}

model MessageTemplate {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id          String        @id @default(cuid())
  name        String
  type        TemplateType  @default(CUSTOM)
  content     String        // Template content with variables like {{client_name}}
  variables   Json?         // Array of variable names: ["client_name", "due_date"]
  isActive    Boolean       @default(true)
  createdBy   String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  messages    Message[]

  @@index([type])
  @@index([isActive])
  @@map("message_templates")
  @@index([firmId])
}

model Message {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  phoneNumber String        // WhatsApp phone number or email address
  templateId  String?
  template    MessageTemplate? @relation(fields: [templateId], references: [id], onDelete: SetNull)
  content     String
  status      MessageStatus @default(PENDING)
  sentAt      DateTime?
  deliveredAt DateTime?
  readAt      DateTime?
  failedAt    DateTime?
  retryCount  Int           @default(0)
  maxRetries  Int           @default(3)
  errorMessage String?
  metadata    Json?         // Additional context (task_id, document_id, provider, etc.)
  sentBy      String        // User who triggered the message
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  logs        MessageLog[]

  @@index([clientId])
  @@index([status])
  @@index([sentAt])
  @@index([templateId])
  @@map("messages")
  @@index([firmId])
}

model MessageLog {
  id          String        @id @default(cuid())
  messageId   String
  message     Message       @relation(fields: [messageId], references: [id], onDelete: Cascade)
  status      MessageStatus
  timestamp   DateTime      @default(now())
  details     Json?         // Additional log details

  @@index([messageId])
  @@index([status])
  @@index([timestamp])
  @@map("message_logs")
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  PARTIALLY_PAID
  OVERDUE
  DISPUTED
  WAIVED
}

model Invoice {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id                String        @id @default(cuid())
  invoiceNumber     String       
  clientId          String
  client            Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  /// Total payable = professionalFee + taxAmount (kept as the canonical amount
  /// for all outstanding/collection math)
  amount            Decimal       @db.Decimal(12, 2)
  paidAmount        Decimal       @default(0) @db.Decimal(12, 2)
  outstandingAmount Decimal       @default(0) @db.Decimal(12, 2)
  status            InvoiceStatus @default(DRAFT)
  dueDate           DateTime
  issueDate         DateTime      @default(now())
  // ── Service-based billing (tax/accounting practice, not e-commerce) ────────
  serviceDescription String?
  serviceType        ServiceType?
  professionalFee    Decimal?     @db.Decimal(12, 2)
  taxRate            Decimal?     @db.Decimal(5, 2)
  taxAmount          Decimal?     @db.Decimal(12, 2)
  remarks            String?
  // ── GST tax-invoice fields ──────────────────────────────────────────────────
  /// Recipient GSTIN (snapshotted from the client at issue time)
  clientGstin        String?
  /// Place-of-supply state name; drives the CGST/SGST vs IGST split
  placeOfSupply      String?
  /// SAC for professional services (default 9982 — accounting/auditing/tax)
  hsnSac             String?
  cgstAmount         Decimal?     @db.Decimal(12, 2)
  sgstAmount         Decimal?     @db.Decimal(12, 2)
  igstAmount         Decimal?     @db.Decimal(12, 2)
  /// Revision chain: a sent invoice is never edited — a revised copy is created
  /// instead. revisedFromId points at the original; both are kept & displayed.
  revisedFromId      String?
  revisedFrom        Invoice?      @relation("InvoiceRevisions", fields: [revisedFromId], references: [id], onDelete: SetNull)
  revisions          Invoice[]     @relation("InvoiceRevisions")
  revisionNumber     Int           @default(0)
  /// The task this invoice was auto-created from (task→invoice workflow).
  sourceTaskId       String?
  /// Soft delete — recycle bin. Every list/query must filter deletedAt: null.
  deletedAt          DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments          PaymentReceipt[]
  followUps         FollowUp[]
  reminders         InvoiceReminder[]

  @@index([clientId])
  @@index([status])
  @@index([dueDate])
  @@index([deletedAt])
  @@index([revisedFromId])
  @@map("invoices")
  @@index([firmId])
  @@unique([firmId, invoiceNumber])
}

model PaymentReceipt {
