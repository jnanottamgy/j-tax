enum LeadStatus {
  NEW_LEAD
  CONTACTED
  QUOTATION_REQUESTED
  FOLLOW_UP_REQUIRED
  CLIENT_WILL_REVERT
  PROPOSAL_SENT
  NEGOTIATION
  WON
  LOST
}

enum LeadSource {
  REFERRAL
  WEBSITE
  WALK_IN
  COLD_CALL
  SOCIAL_MEDIA
  OTHER
}

enum QuotationStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Lead {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id              String     @id @default(cuid())
  name            String
  phone           String?
  email           String
  company         String?
  serviceRequired String?
  source          LeadSource @default(OTHER)
  status          LeadStatus @default(NEW_LEAD)
  estimatedValue  Decimal?   @db.Decimal(12, 2)
  notes           String?
  /// Reason captured when a lead is marked LOST (Reject)
  rejectionReason String?
  assignedTo      String?
  convertedClientId String?
  createdBy       String
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  quotations      Quotation[]
  timelineEvents  ClientTimelineEvent[]

  @@index([status])
  @@index([source])
  @@index([email])
  @@index([createdAt])
  @@index([assignedTo])
  @@map("leads")
  @@index([firmId])
}

model Quotation {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id              String          @id @default(cuid())
  quotationNumber String         
  leadId          String?
  lead            Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  clientName      String
  clientEmail     String
  clientPhone     String?
  clientCompany   String?
  validUntil      DateTime
  status          QuotationStatus @default(DRAFT)
  notes           String?
  terms           String?
  subtotal        Decimal         @db.Decimal(12, 2)
  taxAmount       Decimal         @db.Decimal(12, 2)
  total           Decimal         @db.Decimal(12, 2)
  token           String          @unique
  createdBy       String
  approvedBy      String?
  approvedAt      DateTime?
  sentAt          DateTime?
  viewedAt        DateTime?
  respondedAt     DateTime?
  rejectionReason String?
  /// Set once this (accepted) quotation has been converted into a client —
  /// blocks double-conversion and flips the "Create client" CTA to "View client".
  convertedClientId String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  items           QuotationItem[]
  emailLogs       QuotationEmailLog[]
  followUps       QuotationFollowUp[]

  @@index([status])
  @@index([leadId])
  @@index([token])
  @@index([createdAt])
  @@map("quotations")
  @@index([firmId])
  @@unique([firmId, quotationNumber])
}

model QuotationItem {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  description  String
  serviceType  String?
  quantity     Int       @default(1)
  unitPrice    Decimal   @db.Decimal(12, 2)
  taxRate      Decimal   @db.Decimal(5, 2) @default(18)
  taxAmount    Decimal   @db.Decimal(12, 2)
  total        Decimal   @db.Decimal(12, 2)
  sortOrder    Int       @default(0)

  @@index([quotationId])
  @@map("quotation_items")
}

model QuotationEmailLog {
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  resendId     String?
  emailType    String
  to           String
  subject      String
  status       String    @default("SENT")
  sentAt       DateTime  @default(now())
  deliveredAt  DateTime?
  openedAt     DateTime?

  @@index([quotationId])
  @@map("quotation_email_logs")
}

model QuotationFollowUp {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id           String    @id @default(cuid())
  quotationId  String
  quotation    Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  followUpDay  Int
  scheduledAt  DateTime
  sentAt       DateTime?
  status       String    @default("PENDING")

  @@index([quotationId])
  @@index([scheduledAt])
  @@index([status])
  @@map("quotation_follow_ups")
  @@index([firmId])
}

