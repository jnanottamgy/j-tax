  title       String
  description String?
  sortOrder   Int         @default(0)
  /// Days BEFORE the job due date this step should be completed
  offsetDays  Int         @default(0)

  @@index([templateId])
  @@map("job_template_items")
}

model TaskChecklistItem {
  id        String   @id @default(cuid())
  taskId    String
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean  @default(false)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@map("task_checklist_items")
}

// ─── Time tracking ───────────────────────────────────────────────────────────

model TimeEntry {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id          String    @id @default(cuid())
  taskId      String?
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  clientId    String?
  client      Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  employeeId  String
  employee    Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  description String?
  startedAt   DateTime
  /// Null while the live timer is running
  endedAt     DateTime?
  /// Derived duration, stored for reporting
  minutes     Int       @default(0)
  billable    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([employeeId])
  @@index([clientId])
  @@index([taskId])
  @@index([startedAt])
  @@index([employeeId, startedAt])
  @@map("time_entries")
  @@index([firmId])
}

// ─── PBC document request lists ──────────────────────────────────────────────

model DocumentRequest {
  firmId String  @default("")
  firm   Firm    @relation(fields: [firmId], references: [id], onDelete: Cascade)
  id             String                @id @default(cuid())
  clientId       String
  client         Client                @relation(fields: [clientId], references: [id], onDelete: Cascade)
  title          String
  /// OPEN, COMPLETED, CANCELLED
  status         String                @default("OPEN")
  dueDate        DateTime?
  notes          String?
  createdBy      String
  /// Chase-cadence bookkeeping (reminders stop when all items resolve)
  lastRemindedAt DateTime?
  items          DocumentRequestItem[]
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@index([clientId])
  @@index([status])
  @@map("document_requests")
  @@index([firmId])
}

model DocumentRequestItem {
  id              String          @id @default(cuid())
  requestId       String
  request         DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  title           String
  /// PENDING, UPLOADED, ACCEPTED, REJECTED
  status          String          @default("PENDING")
  documentId      String?
  document        Document?       @relation(fields: [documentId], references: [id], onDelete: SetNull)
  rejectionReason String?
  sortOrder       Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([requestId])
  @@index([status])
  @@map("document_request_items")
}
